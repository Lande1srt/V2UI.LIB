<Window x:Class="F2CS.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="F2CS.UI 样式演示"
        Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border CornerRadius="8" Background="{DynamicResource BodyBackgroundGradient}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 自定义标题栏 -->
            <Grid Grid.Row="0" Background="{DynamicResource CardBackground}" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" 
                           Text="F2CS.UI 样式演示" 
                           VerticalAlignment="Center" 
                           Margin="10,0,0,0"
                           Foreground="{DynamicResource ControlForeground}"
                           FontSize="12"
                           FontWeight="SemiBold"/>
                
                <Button Grid.Column="1" 
                        Content="&#xE949;" 
                        FontFamily="Segoe MDL2 Assets" 
                        FontSize="10"
                        Background="Transparent"
                        Foreground="{DynamicResource ControlForeground}"
                        BorderThickness="0"
                        Padding="0"
                        Margin="0"
                        Height="32"
                        Width="32"
                        Click="Minimize_Click"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                Width="{TemplateBinding Width}" 
                                                Height="{TemplateBinding Height}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                
                <Button Grid.Column="2" 
                        Content="&#xE923;" 
                        FontFamily="Segoe MDL2 Assets" 
                        FontSize="10"
                        Background="Transparent"
                        Foreground="{DynamicResource ControlForeground}"
                        BorderThickness="0"
                        Padding="0"
                        Margin="0"
                        Height="32"
                        Width="32"
                        Click="Maximize_Click"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                Width="{TemplateBinding Width}" 
                                                Height="{TemplateBinding Height}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                
                <Button Grid.Column="3" 
                        Content="&#xE8BB;" 
                        FontFamily="Segoe MDL2 Assets" 
                        FontSize="10"
                        Background="Transparent"
                        Foreground="{DynamicResource ControlForeground}"
                        BorderThickness="0"
                        Padding="0"
                        Margin="0"
                        Height="32"
                        Width="32"
                        Click="Close_Click"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                Width="{TemplateBinding Width}" 
                                                Height="{TemplateBinding Height}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E81123"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- 主内容区域 -->
            <ScrollViewer Grid.Row="1" Margin="20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                        <Button Content="亮色主题" Click="LightTheme_Click" Margin="0,0,10,0"/>
                        <Button Content="暗色主题" Click="DarkTheme_Click"/>
                    </StackPanel>

                    <TabControl Grid.Row="1" Margin="0,0,0,20" Height="500">
                    <TabItem Header="基础控件">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <GroupBox Header="按钮" Margin="0,0,0,15">
                                    <StackPanel Orientation="Horizontal" Margin="10">
                                        <Button Content="普通按钮" Margin="0,0,10,0"/>
                                        <Button Content="禁用按钮" IsEnabled="False" Margin="0,0,10,0"/>
                                        <Button Content="悬停效果" Margin="0,0,10,0"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="输入框" Margin="0,0,0,15">
                                    <StackPanel Margin="10">
                                        <TextBox Text="普通输入框" Margin="0,0,0,10"/>
                                        <TextBox Text="禁用输入框" IsEnabled="False"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="下拉框" Margin="0,0,0,15">
                                    <StackPanel Margin="10">
                                        <ComboBox Margin="0,0,0,10" SelectedIndex="0">
                                            <ComboBoxItem>选项1</ComboBoxItem>
                                            <ComboBoxItem>选项2</ComboBoxItem>
                                            <ComboBoxItem>选项3</ComboBoxItem>
                                        </ComboBox>
                                        <ComboBox IsEnabled="False">
                                            <ComboBoxItem>禁用选项</ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="复选框" Margin="0,0,0,15">
                                    <StackPanel Margin="10" Orientation="Horizontal">
                                        <CheckBox Content="未选中" Margin="0,0,10,0"/>
                                        <CheckBox Content="已选中" IsChecked="True" Margin="0,0,10,0"/>
                                        <CheckBox Content="禁用" IsEnabled="False"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="进度条" Margin="0,0,0,15">
                                    <StackPanel Margin="10">
                                        <ProgressBar Value="30" Height="20" Margin="0,0,0,10"/>
                                        <ProgressBar Value="60" Height="20" Margin="0,0,0,10"/>
                                        <ProgressBar Value="90" Height="20"/>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="布局演示">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <GroupBox Header="卡片布局示例" Margin="0,0,0,15">
                                    <Grid Margin="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource CardBackground}" 
                                                BorderBrush="{DynamicResource CardBorderBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="4"
                                                Padding="10"
                                                Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="卡片标题" 
                                                           FontWeight="SemiBold" 
                                                           FontSize="14"
                                                           Foreground="{DynamicResource CardHeadingForeground}"
                                                           Margin="0,0,0,5"/>
                                                <TextBlock Text="这是卡片内容，展示了卡片的样式效果。" 
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextForeground}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource CardBackground}" 
                                                BorderBrush="{DynamicResource CardBorderBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="4"
                                                Padding="10"
                                                Grid.Column="1">
                                            <StackPanel>
                                                <TextBlock Text="另一张卡片" 
                                                           FontWeight="SemiBold" 
                                                           FontSize="14"
                                                           Foreground="{DynamicResource CardHeadingForeground}"
                                                           Margin="0,0,0,5"/>
                                                <TextBlock Text="卡片可以承载各种内容。" 
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextForeground}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="标签展示" Margin="0,0,0,15">
                                    <StackPanel Orientation="Horizontal" Margin="10">
                                        <Border Background="{DynamicResource TagBackground}" 
                                                Padding="8,4" 
                                                CornerRadius="4"
                                                Margin="0,0,10,0">
                                            <TextBlock Text="标签1" Foreground="{DynamicResource TagForeground}"/>
                                        </Border>
                                        <Border Background="{DynamicResource TagBackground}" 
                                                Padding="8,4" 
                                                CornerRadius="4"
                                                Margin="0,0,10,0">
                                            <TextBlock Text="标签2" Foreground="{DynamicResource TagForeground}"/>
                                        </Border>
                                        <Border Background="{DynamicResource TagBackground}" 
                                                Padding="8,4" 
                                                CornerRadius="4">
                                            <TextBlock Text="标签3" Foreground="{DynamicResource TagForeground}"/>
                                        </Border>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <TextBlock Grid.Row="2" 
                           Text="F2CS.UI 样式库 - 基于 ISRTOOL 主题提取" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Bottom"
                           Foreground="{DynamicResource TextForeground}"
                           FontSize="12"/>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
