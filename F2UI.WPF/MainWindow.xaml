<Window x:Class="F2CS.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="F2CS.UI 样式演示"
        Height="700" Width="900"
        WindowStartupLocation="CenterScreen">
    <Border Background="{DynamicResource BodyBackgroundGradient}">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <Button Style="{StaticResource PrimaryButton}" Content="亮色主题" Click="LightTheme_Click" Margin="0,0,10,0"/>
                <Button Style="{StaticResource PrimaryButton}" Content="暗色主题" Click="DarkTheme_Click"/>
            </StackPanel>

            <TabControl Grid.Row="1" Margin="0,0,0,20" Height="500">
                    <TabItem Header="基础控件">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <GroupBox Header="按钮" Margin="0,0,0,15">
                                    <StackPanel Orientation="Horizontal" Margin="10">
                                        <Button Content="普通按钮" Margin="0,0,10,0"/>
                                        <Button Content="禁用按钮" IsEnabled="False" Margin="0,0,10,0"/>
                                        <Button Style="{StaticResource HoverStateButton}" Content="悬停效果" Margin="0,0,10,0"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="输入框" Margin="0,0,0,15">
                                    <StackPanel Margin="10">
                                        <TextBox Text="普通输入框" Margin="0,0,0,10"/>
                                        <TextBox Text="禁用输入框" IsEnabled="False"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="下拉框" Margin="0,0,0,15">
                                    <StackPanel Margin="10">
                                        <ComboBox Margin="0,0,0,10" SelectedIndex="0">
                                            <ComboBoxItem>选项1</ComboBoxItem>
                                            <ComboBoxItem>选项2</ComboBoxItem>
                                            <ComboBoxItem>选项3</ComboBoxItem>
                                        </ComboBox>
                                        <ComboBox IsEnabled="False">
                                            <ComboBoxItem>禁用选项</ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="复选框" Margin="0,0,0,15">
                                    <StackPanel Margin="10" Orientation="Horizontal">
                                        <CheckBox Content="未选中" Margin="0,0,10,0"/>
                                        <CheckBox Content="已选中" IsChecked="True" Margin="0,0,10,0"/>
                                        <CheckBox Content="禁用" IsEnabled="False"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="进度条" Margin="0,0,0,15">
                                    <StackPanel Margin="10">
                                        <ProgressBar Value="30" Height="20" Margin="0,0,0,10"/>
                                        <ProgressBar Value="60" Height="20" Margin="0,0,0,10"/>
                                        <ProgressBar Value="90" Height="20"/>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="布局演示">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <GroupBox Header="卡片布局示例" Margin="0,0,0,15">
                                    <Grid Margin="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource CardBackground}" 
                                                BorderBrush="{DynamicResource CardBorderBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="4"
                                                Padding="10"
                                                Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="卡片标题" 
                                                           FontWeight="SemiBold" 
                                                           FontSize="14"
                                                           Foreground="{DynamicResource CardHeadingForeground}"
                                                           Margin="0,0,0,5"/>
                                                <TextBlock Text="这是卡片内容，展示了卡片的样式效果。" 
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextForeground}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource CardBackground}" 
                                                BorderBrush="{DynamicResource CardBorderBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="4"
                                                Padding="10"
                                                Grid.Column="1">
                                            <StackPanel>
                                                <TextBlock Text="另一张卡片" 
                                                           FontWeight="SemiBold" 
                                                           FontSize="14"
                                                           Foreground="{DynamicResource CardHeadingForeground}"
                                                           Margin="0,0,0,5"/>
                                                <TextBlock Text="卡片可以承载各种内容。" 
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextForeground}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="标签展示" Margin="0,0,0,15">
                                    <StackPanel Orientation="Horizontal" Margin="10">
                                        <Border Background="{DynamicResource TagBackground}" 
                                                Padding="8,4" 
                                                CornerRadius="4"
                                                Margin="0,0,10,0">
                                            <TextBlock Text="标签1" Foreground="{DynamicResource TagForeground}"/>
                                        </Border>
                                        <Border Background="{DynamicResource TagBackground}" 
                                                Padding="8,4" 
                                                CornerRadius="4"
                                                Margin="0,0,10,0">
                                            <TextBlock Text="标签2" Foreground="{DynamicResource TagForeground}"/>
                                        </Border>
                                        <Border Background="{DynamicResource TagBackground}" 
                                                Padding="8,4" 
                                                CornerRadius="4">
                                            <TextBlock Text="标签3" Foreground="{DynamicResource TagForeground}"/>
                                        </Border>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
    </Border>
</Window>
